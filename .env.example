# Conexão da aplicação: papel sem privilégios, sujeito ao isolamento (RLS)
DATABASE_URL=postgresql://app_user:troque-esta-senha@localhost:5432/soluccini
# Conexão das migrações: papel dono das tabelas
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soluccini

# Chaves de 32 bytes em base64. Gere com: openssl rand -base64 32
# Em produção, venham de um cofre de segredos. Trocar a chave de cifra exige migrar os dados.
CHAVE_CIFRA=
CHAVE_INDICE=

# Armazenamento de documentos: "local" (desenvolvimento) ou "s3"
ARMAZENAMENTO=local
ARMAZENAMENTO_DIR=./.armazenamento
S3_BUCKET=
S3_REGIAO=sa-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Nome que aparece no aplicativo autenticador
TOTP_EMISSOR=Soluccini
